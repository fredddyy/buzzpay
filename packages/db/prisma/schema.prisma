generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Connection pooling: use ?connection_limit=20&pool_timeout=30 in DATABASE_URL for production
}

enum UserRole {
  STUDENT
  VENDOR
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DealCategory {
  FOOD
  DRINKS
  SUBSCRIPTIONS
  TRANSPORT
  SHOPPING
  LIFESTYLE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  role         UserRole @default(STUDENT)
  fullName     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fcmToken       String?   // Firebase Cloud Messaging device token
  walletBalance  Int       @default(0) // kobo
  referralCode   String?   @unique
  referredById   String?
  referralCount  Int       @default(0)

  student  Student?
  vendor   Vendor?
  payments Payment[]
  streak   UserStreak?
  walletTransactions WalletTransaction[]

  @@index([email])
  @@index([phone])
}

model Student {
  id                  String             @id @default(cuid())
  userId              String             @unique
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  university          String
  studentIdImageUrl   String?
  schoolEmail         String?
  schoolEmailVerified Boolean            @default(false)
  verificationStatus  VerificationStatus @default(PENDING)
  verifiedAt          DateTime?
  rejectionReason     String?
  referralFirstPurchaseDone Boolean    @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  vouchers      Voucher[]
  loyaltyCards  LoyaltyCard[]

  @@index([verificationStatus])
  @@index([university])
}

model Vendor {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName    String
  businessAddress String
  businessPhone   String
  logoUrl         String?
  isActive        Boolean  @default(true)
  isTrending      Boolean  @default(false)
  opensAt         String   @default("08:00") // HH:mm in WAT
  closesAt        String   @default("21:00") // HH:mm in WAT
  dailyCode       String?
  dailyCodeDate   DateTime?
  commissionRate  Float    @default(0.10)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deals        Deal[]
  payments     Payment[]
  payouts      Payout[]
  bankAccount  VendorBankAccount?
  loyaltyCards LoyaltyCard[]
  qrCodes      VendorQrCode[]

  @@index([isActive])
}

model Deal {
  id            String       @id @default(cuid())
  vendorId      String
  vendor        Vendor       @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title         String
  description   String
  category      DealCategory
  imageUrl      String?
  originalPrice Int
  studentPrice  Int
  totalQuantity Int
  remainingQty  Int
  maxPerUser    Int          @default(1)
  startsAt      DateTime
  expiresAt     DateTime
  isActive      Boolean      @default(true)
  isFeatured    Boolean      @default(false)
  guestAccess   Boolean      @default(false) // visible + purchasable by unverified students
  dailyStart    String?      // HH:mm — daily window start (WAT)
  dailyEnd      String?      // HH:mm — daily window end (WAT)
  previewStart  String?      // HH:mm — when deal becomes visible in preview mode (WAT)
  activeDays    Int[]        @default([]) // 0=Sun..6=Sat — empty means every day
  isRecurring   Boolean      @default(false) // repeats daily within startsAt–expiresAt
  featuredSection String?    // e.g. "Hot in Akoka", "Breakfast Rush"
  tags          String[]     @default([]) // e.g. ["shawarma", "wraps", "late-night"]
  campaignId    String?
  campaign      Campaign?    @relation(fields: [campaignId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  vouchers   Voucher[]
  payments   Payment[]
  orderItems OrderItem[]

  @@index([category, isActive])
  @@index([vendorId])
  @@index([isActive, expiresAt])
  @@index([isFeatured, isActive])
  @@index([isActive, startsAt, expiresAt, remainingQty]) // peak-load: active deals with stock
  @@index([vendorId, isActive, expiresAt])               // vendor deal listings
}

model Campaign {
  id              String   @id @default(cuid())
  name            String   // e.g. "Breakfast Rush Monday"
  featuredSection String?  // section name on student feed
  dailyStart      String?  // shared schedule
  dailyEnd        String?
  previewStart    String?
  activeDays      Int[]    @default([])
  status          String   @default("DRAFT") // DRAFT, PUBLISHED
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  deals Deal[]
}

model Voucher {
  id             String        @id @default(cuid())
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  dealId         String
  deal           Deal          @relation(fields: [dealId], references: [id])
  paymentId      String
  payment        Payment       @relation(fields: [paymentId], references: [id])
  orderItemId    String?
  orderItem      OrderItem?    @relation(fields: [orderItemId], references: [id])
  code           String        @unique
  qrData         String        @unique
  qrSecret       String?       // HMAC secret for rotating QR codes
  status         VoucherStatus @default(ACTIVE)
  expiresAt      DateTime
  redeemedAt     DateTime?
  redeemedByCode Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([studentId, status])
  @@index([code])
  @@index([qrData])
  @@index([status, expiresAt])
  @@index([dealId, status])      // vendor redemption lookups
  @@index([studentId, createdAt]) // student voucher history
  @@index([paymentId])           // multiple vouchers per payment
  @@index([orderItemId])
}

model Payment {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id])
  dealId             String?       // legacy single-deal payments (nullable for cart payments)
  deal               Deal?         @relation(fields: [dealId], references: [id])
  vendorId           String?       // cart payments: which vendor this payment is for
  vendor             Vendor?       @relation(fields: [vendorId], references: [id])
  amount             Int
  commission         Int
  vendorAmount       Int
  paystackReference  String        @unique
  paystackAccessCode String?
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  vouchers   Voucher[]
  orderItems OrderItem[]
  payoutItems PayoutItem[]

  @@index([userId])
  @@index([paystackReference])
  @@index([status])
  @@index([dealId, status])        // deal revenue aggregation
  @@index([userId, dealId, createdAt]) // per-user daily limit check
  @@index([status, createdAt])     // admin transaction listing
  @@index([vendorId])
}

model OrderItem {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id])
  quantity  Int      @default(1)
  unitPrice Int      // studentPrice at time of purchase (kobo)
  subtotal  Int      // unitPrice * quantity (kobo)
  createdAt DateTime @default(now())

  vouchers Voucher[]

  @@index([paymentId])
  @@index([dealId])
}

model Payout {
  id                   String       @id @default(cuid())
  vendorId             String
  vendor               Vendor       @relation(fields: [vendorId], references: [id])
  amount               Int          // kobo — total vendor payout
  periodStart          DateTime
  periodEnd            DateTime
  voucherCount         Int
  status               String       @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  paystackTransferCode String?
  paystackTransferId   String?      @unique
  reference            String?      @unique // our payout reference
  paidAt               DateTime?
  failureReason        String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  items PayoutItem[]

  @@index([vendorId, status])
  @@index([status])
}

model PayoutItem {
  id        String   @id @default(cuid())
  payoutId  String
  payout    Payout   @relation(fields: [payoutId], references: [id])
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id])
  amount    Int      // vendorAmount from this payment
  createdAt DateTime @default(now())

  @@unique([payoutId, paymentId])
  @@index([paymentId])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // TOP_UP, PURCHASE, REFUND, REFERRAL_BONUS
  amount    Int      // kobo (positive for credit, negative for debit)
  balance   Int      // balance after this transaction
  reference String?  // Paystack reference for top-ups
  dealId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String   // deal_viewed, payment_completed, voucher_redeemed, app_opened, deal_shared
  dealId    String?
  vendorId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, event])
  @@index([dealId])
}

model UserStreak {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  currentStreak  Int      @default(0)  // consecutive days with a purchase
  longestStreak  Int      @default(0)
  lastPurchaseDate DateTime? // date of last purchase (no time)
  updatedAt      DateTime @updatedAt
}

model VendorBankAccount {
  id            String    @id @default(cuid())
  vendorId      String    @unique
  vendor        Vendor    @relation(fields: [vendorId], references: [id])
  accountNumber String
  bankCode      String
  bankName      String
  accountName   String
  recipientCode String?   // Paystack transfer recipient code
  isVerified    Boolean   @default(false)
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OTP {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model LoyaltyCard {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  stamps      Int      @default(0)  // current stamps collected
  target      Int      @default(5)  // stamps needed for free deal
  rewardsUsed Int      @default(0)  // how many free deals claimed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, vendorId])
  @@index([studentId])
  @@index([vendorId])
}

model VendorQrCode {
  id             String    @id @default(cuid())
  serialNumber   String    @unique // e.g. "BZ-9942" — printed on physical sticker
  vendorId       String?
  vendor         Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  assignedBy     String?   // admin user ID who linked the sticker
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([vendorId])
  @@index([serialNumber])
}
