{
  "name": "buzzpay",
  "private": true,
  "scripts": {
    "dev:api": "turbo run dev --filter=@buzzpay/api",
    "dev:web": "turbo run dev --filter=web",
    "build": "pnpm --filter @buzzpay/db exec prisma generate && pnpm --filter @buzzpay/api build",
    "start": "pnpm --filter @buzzpay/db exec prisma migrate deploy && node apps/api/dist/index.js",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @buzzpay/db migrate:dev",
    "db:seed": "pnpm --filter @buzzpay/db seed",
    "db:studio": "pnpm --filter @buzzpay/db studio"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
